<rml>
<head>
	<title>Import game files</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="import.rcss"/>
</head>
<body template="dialog" data-model="import">
	<p id="heading">{{heading}}</p>
	<p id="body">{{body}}</p>
	<p id="step">{{step}}</p>
	<p id="path">{{path}}</p>
	<div id="buttons">
		<button id="choose" class="wide" data-class-disabled="!canchoose" data-event-click="queue('choose')">{{chooselabel}}</button>
		<button id="cancel" class="wide" data-class-disabled="!cancancel" data-event-click="queue('cancel')">{{cancellabel}}</button>
	</div>
</body>
</rml>
